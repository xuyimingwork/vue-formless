{
  "name": "vue-formx",
  "version": "0.0.0",
  "description": "Vue 表单组合式工具库",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuyimingwork/vue-formx.git"
  },
  "homepage": "https://github.com/xuyimingwork/vue-formx#readme",
  "bugs": {
    "url": "https://github.com/xuyimingwork/vue-formx/issues"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "form",
    "composable",
    "hooks"
  ],
  "author": "Xu Yiming",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.16"
  }
}
