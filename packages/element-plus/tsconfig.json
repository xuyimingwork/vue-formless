{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "vue-formless": ["../vue-formless/src/index.ts"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
