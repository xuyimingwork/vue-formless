{
  "name": "vue-formless",
  "version": "0.1.1",
  "description": "Vue 3 表单组合式 hooks",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @vue-formless/layout build && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuyimingwork/vue-formless.git"
  },
  "homepage": "https://github.com/xuyimingwork/vue-formless#readme",
  "bugs": {
    "url": "https://github.com/xuyimingwork/vue-formless/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "form",
    "composable",
    "hooks"
  ],
  "author": "Xu Yiming",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue-formless/layout": "workspace:*",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.16"
  }
}
